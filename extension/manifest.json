{
  "manifest_version": 3,
  "name": "Reticle",
  "version": "0.1.0",
  "description": "Hands the tab you are on to Reticle, so an agent can read and act on the page.",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Hand this tab to Reticle"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Hand this tab to Reticle"
    }
  }
}
